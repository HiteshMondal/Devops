################################################################################
# Jenkins CI/CD — Environment Configuration
################################################################################
# Usage:
#   1. cp jenkins.env.example jenkins.env
#   2. Fill in the values below (jenkins.env is git-ignored, never commit it)
#   3. Run: ../scripts/deploy_jenkins.sh
#
# This file is intentionally separate from the project-root .env so the
# Jenkins stack can be configured, deployed, and reset independently of the
# rest of the platform. Any value left blank here that also exists in the
# project-root .env (GITHUB_TOKEN, DOCKERHUB_USERNAME, AWS_* etc.) is picked
# up from there automatically by docker-compose.yml — you only need to set
# values here that are unique to Jenkins.
################################################################################

# Image / container naming
JENKINS_VERSION=lts-jdk17
JENKINS_IMAGE_NAME=devops-jenkins
JENKINS_IMAGE_TAG=latest
JENKINS_CONTAINER_NAME=jenkins-controller
JENKINS_DIND_CONTAINER_NAME=jenkins-docker-dind
JENKINS_NETWORK_NAME=jenkins-net
JENKINS_VOLUME_NAME=jenkins_data
JENKINS_DOCKER_CERTS_VOLUME=jenkins_docker_certs
JENKINS_DIND_VOLUME_NAME=jenkins_dind_data

# Ports (change if these collide with something else on your host)
JENKINS_HTTP_PORT=8090
JENKINS_AGENT_PORT=50000
JENKINS_URL=http://localhost:8090/

# Admin account (REQUIRED — used by JCasC to seed the security realm)
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change-me-strong-password

# Kubernetes access
# Base64 of a kubeconfig file, e.g.:  base64 -w0 ~/.kube/config
# Or run ../scripts/configure_jenkins.sh, which does this for you.
KUBECONFIG_CONTENTS_BASE64=

# Optional overrides
# Leave blank to fall back to the same-named values in the project-root .env
GITHUB_USERNAME=
GITHUB_TOKEN=
DOCKERHUB_USERNAME=
DOCKERHUB_PASSWORD=
GIT_REPO_URL=
GIT_REPO_BRANCH=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
ARGOCD_ADMIN_PASSWORD=
APP_NAME=
NAMESPACE=
DOCKER_IMAGE_TAG=
TRIVY_VERSION=
TRIVY_SEVERITY=
