################################################################################
# DevOps Project — Environment Configuration
################################################################################
# Usage:
#   1. Copy this file to `.env`
#   2. Update ALL required values
#   3. Run: ./run.sh
#
# CI/CD Variables:
#   - GitHub Actions → Repo Settings → Secrets and variables → Actions
#   - GitLab         → Project Settings → CI/CD → Variables
################################################################################


################################################################################
# APPLICATION CONFIGURATION
################################################################################

APP_NAME=devops-app
NAMESPACE=devops-app
APP_PORT=8000

# Replica & Autoscaling configuration
REPLICAS=2
MIN_REPLICAS=2
MAX_REPLICAS=10
CPU_TARGET_UTILIZATION=70
MEMORY_TARGET_UTILIZATION=80

# Runtime configuration
APP_ENV=production
LOG_LEVEL=info

# Resource requests & limits
APP_CPU_REQUEST=100m
APP_CPU_LIMIT=500m
APP_MEMORY_REQUEST=128Mi
APP_MEMORY_LIMIT=512Mi


################################################################################
# INGRESS CONFIGURATION (OPTIONAL)
################################################################################

# Enable or disable Kubernetes Ingress
INGRESS_ENABLED=true

# Ingress hostname
# NOTE: For local clusters, add this to /etc/hosts
INGRESS_HOST=devops-app.local

# Ingress controller class
# Common values:
#   nginx   — minikube, kind, microk8s
#   traefik — k3s
#   alb     — AWS EKS
#   gce     — GKE
#   azure/application-gateway — AKS
INGRESS_CLASS=nginx

# TLS secret name (used mainly in production with cert-manager)
TLS_SECRET_NAME=devops-app-tls


################################################################################
# DOCKER / CONTAINER REGISTRY
################################################################################

# DockerHub credentials (required if BUILD_PUSH=true)
DOCKERHUB_USERNAME=yourdockerhubusername
DOCKERHUB_PASSWORD=your-dockerhub-password-or-token

# Image tag to use
DOCKER_IMAGE_TAG=latest


################################################################################
# GIT & GITHUB CONFIGURATION
################################################################################

# Git author configuration
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=you@example.com

# GitHub configuration
GITHUB_USERNAME=yourgithubusername
GITHUB_EMAIL=yourmail@example.com
GITHUB_TOKEN=your-github-personal-access-token

# Repository URL
GIT_REPO_URL=https://github.com/User_Name/Project_Name.git


################################################################################
# DATABASE CONFIGURATION (OPTIONAL)
# Injected via Kubernetes ConfigMaps / Secrets
################################################################################

DB_HOST=localhost
DB_PORT=5432
DB_NAME=devopsdb
DB_USERNAME=
DB_PASSWORD=


################################################################################
# APPLICATION SECRETS (OPTIONAL)
# Stored as Kubernetes Secrets
################################################################################

JWT_SECRET=
API_KEY=
SESSION_SECRET=


################################################################################
# ARGO CD CONFIGURATION (OPTIONAL)
################################################################################

# Argo CD admin password
# If unset, it will be retrieved from the default admin secret
ARGOCD_ADMIN_PASSWORD=

################################################################################
# INFRA / TERRAFORM CONFIGURATION (AWS — Free Tier sized)
# Add this block to .env.example / .env as-is.
# Terraform reads TF_VAR_<name> environment variables automatically, and
# deploy_infra.sh exports everything in .env via `set -a` before it runs
# terraform — so these TF_VAR_ lines are the only wiring needed. They
# deliberately re-use the values you already set above so there is a
# single source of truth.
################################################################################
AWS_REGION=us-east-1

# --- required: fed from the DB_* block already in this file ---
TF_VAR_db_username=${DB_USERNAME}
TF_VAR_db_password=${DB_PASSWORD}
TF_VAR_db_name=${DB_NAME}
TF_VAR_db_port=${DB_PORT}

# --- required: fed from the APPLICATION CONFIGURATION block already in this file ---
TF_VAR_app_name=${APP_NAME}
TF_VAR_app_port=${APP_PORT}
TF_VAR_aws_region=${AWS_REGION}

# --- optional overrides (defaults already Free-Tier sized, uncomment to change) ---
# TF_VAR_kubernetes_version=1.30
# TF_VAR_node_instance_type=t3.micro
# TF_VAR_node_desired_size=1
# TF_VAR_db_instance_class=db.t3.micro
# TF_VAR_db_allocated_storage=20
# TF_VAR_enable_nat_gateway=false
# TF_VAR_db_deletion_protection=false
